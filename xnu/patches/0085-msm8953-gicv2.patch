diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index b8be8df..2d1a35d 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1853,7 +1853,7 @@ sleh_irq(arm_saved_state_t *state)
 #endif
 
 
-#if defined(SWEET)
+#if defined(SWEET) && !HAS_GIC_V2
 	/*
 	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
 	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
@@ -1888,6 +1888,44 @@ sleh_irq(arm_saved_state_t *state)
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
 	}
 	__builtin_arm_isb(ISB_SY);
+#elif HAS_GIC_V2
+	/*
+	 * GICv2: the interrupt is acknowledged from the CPU interface in MMIO
+	 * (GICC_IAR) and retired by writing it back to GICC_EOIR, instead of
+	 * the ICC_IAR1_EL1/ICC_EOIR1_EL1 system registers GICv3 provides.
+	 */
+	extern uint32_t msm_vtimer_intid;
+	extern uint32_t gic_v2_iar(void);
+	extern void gic_v2_eoir(uint32_t iar);
+
+	uint32_t iar = gic_v2_iar();
+	uint32_t intid = iar & 0xFFFFFFu;
+
+	if (intid >= 1020 && intid <= 1023) {
+		return; /* spurious */
+	}
+	if (intid == msm_vtimer_intid) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
+		cdp->cpu_decrementer = -1; /* Large */
+		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
+		rtclock_intr(TRUE);
+		INTERRUPT_MASKED_DEBUG_END();
+		gic_v2_eoir(iar);
+	} else if (intid < 16) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
+		/* Retire before handling so an IPI raised meanwhile is not lost. */
+		gic_v2_eoir(iar);
+		cpu_signal_handler();
+	} else {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
+		if (cdp->interrupt_handler) {
+			cdp->interrupt_handler(cdp->interrupt_target,
+			    cdp->interrupt_refCon,
+			    cdp->interrupt_nub,
+			    intid);
+		}
+		gic_v2_eoir(iar);
+	}
 #else
 	sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
 
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..b3b1203 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -222,6 +222,145 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif HAS_GIC_V2
+/*
+ * GICv2 (ARM GIC-400): one distributor and a single per-CPU interface. No
+ * redistributors (so no per-core wake-up dance) and no ICC_* system
+ * registers: acknowledge, EOI and SGI all go through MMIO.
+ *
+ * The addresses are read from the ADT (/arm-io/gic "reg": gicd_base,
+ * gicd_size, gicc_base, gicc_size), never compiled in -- the same code runs
+ * under QEMU (-M virt,gic-version=2, 0x08000000/0x08010000) and on msm8953
+ * (0x0b000000/0x0b002000).
+ */
+SECURITY_READ_ONLY_LATE(uint32_t) msm_vtimer_intid = MSM8953_VTIMER_INTID;
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+
+static uint32_t
+_gic_read32(vm_offset_t addr)
+{
+	return *((volatile uint32_t *) addr);
+}
+
+static void
+_gic_write32(vm_offset_t addr, uint32_t value)
+{
+	*((volatile uint32_t *) addr) = value;
+}
+
+#define gicd_read32(offset) (_gic_read32(gicd_base + (offset)))
+#define gicd_write32(offset, data) (_gic_write32(gicd_base + (offset), (data)))
+#define gicc_read32(offset) (_gic_read32(gicc_base + (offset)))
+#define gicc_write32(offset, data) (_gic_write32(gicc_base + (offset), (data)))
+
+/* Interface for sleh_irq(): GICv2 acknowledges with MMIO, not ICC_IAR1_EL1. */
+uint32_t
+gic_v2_iar(void)
+{
+	return gicc_read32(GICC_IAR) & 0xFFFFFFu;
+}
+
+void
+gic_v2_eoir(uint32_t iar)
+{
+	gicc_write32(GICC_EOIR, iar);
+	__builtin_arm_isb(ISB_SY);
+}
+
+/* Cross-CPU signal: GICv2 raises an SGI through GICD_SGIR. */
+void
+gic_v2_send_sgi(unsigned int sgi, unsigned int target_mask)
+{
+	gicd_write32(GICD_SGIR, GICD_SGIR_SGIINTID(sgi) | GICD_SGIR_NSATT |
+	    GICD_SGIR_TARGET_LIST(target_mask));
+	__builtin_arm_isb(ISB_SY);
+}
+
+void
+pe_init_fiq(void)
+{
+	DTEntry entry;
+	void const *prop;
+	unsigned int prop_size;
+
+	/* Secondary processors: the boot CPU has already programmed everything
+	 * (the distributor and CPU interface are per-cluster / per-core, and
+	 * all of them share the same MMIO window). */
+	if (gicd_base) {
+		gicc_write32(GICC_PMR, 0xFF);
+		gicc_write32(GICC_BPR, 0);
+		gicc_write32(GICC_CTLR, GICC_CTLR_ENABLE);
+		__builtin_arm_isb(ISB_SY);
+		return;
+	}
+
+	if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess) {
+		panic("%s: cannot find GIC node in DT", __func__);
+	}
+	if (SecureDTGetProperty(entry, "reg", &prop, &prop_size) != kSuccess) {
+		panic("%s: cannot find GIC MMIO regions in DT", __func__);
+	}
+	if (prop_size < 4 * sizeof(uint64_t)) {
+		panic("%s: GIC reg property too small (%u bytes)", __func__, prop_size);
+	}
+
+	/* Optional ADT override of the virtual timer PPI (QEMU/GICv2 use 27). */
+	void const *timer_prop;
+	unsigned int timer_size;
+	if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+		if (timer_size != sizeof(uint32_t)) {
+			panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+		}
+		uint32_t intid = *(const uint32_t *)timer_prop;
+		if (intid < 16 || intid >= 32) {
+			panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+		}
+		msm_vtimer_intid = intid;
+	}
+	kprintf("MSM8953 GICv2: virtual timer INTID %u\n", msm_vtimer_intid);
+
+	vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+	uint64_t const gicd_prop = ((uint64_t const *) prop)[0];
+	uint64_t const gicd_size = ((uint64_t const *) prop)[1];
+	uint64_t const gicc_prop = ((uint64_t const *) prop)[2];
+	uint64_t const gicc_size = ((uint64_t const *) prop)[3];
+
+	gicd_base = ml_io_map(soc_base_phys + gicd_prop, gicd_size);
+	if (!gicd_base) {
+		panic("%s: cannot map GICD", __func__);
+	}
+	gicc_base = ml_io_map(soc_base_phys + gicc_prop, gicc_size);
+	if (!gicc_base) {
+		panic("%s: cannot map GICC", __func__);
+	}
+
+	/* Distributor on: GICv2 has a single enable bit (no Group0/Group1
+	 * split like GICv3's ENABLEGRP1/ENABLEGRP1A). */
+	gicd_write32(GICD_CTLR, GICD_CTLR_ENABLE);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+
+	/*
+	 * SGI/PPI bank (INTIDs 0..31). Group 1, mid priority, then enable the
+	 * virtual timer PPI and the SGI XNU uses for cross-CPU signals. On a
+	 * phone these arrive as IRQs to the non-secure side, exactly like
+	 * sweet's Group 1 interrupts.
+	 */
+	gicd_write32(GICD_IGROUPR, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER, (1U << msm_vtimer_intid) | (1U << MSM8953_IPI_SGI));
+
+	/* CPU interface: wide priority mask, no subpriority grouping, enabled. */
+	gicc_write32(GICC_PMR, 0xFF);
+	gicc_write32(GICC_BPR, 0);
+	gicc_write32(GICC_CTLR, GICC_CTLR_ENABLE);
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
diff --git a/pexpert/pexpert/arm64/MSM8953.h b/pexpert/pexpert/arm64/MSM8953.h
new file mode 100644
index 0000000..408eeea
--- /dev/null
+++ b/pexpert/pexpert/arm64/MSM8953.h
@@ -0,0 +1,125 @@
+/*
+ * Board config for the Nubia Z11 mini s (nx549j, Qualcomm MSM8953 /
+ * Snapdragon 625): eight Cortex-A53, ARMv8.0, no PAC.
+ *
+ * Differences from SWEET (SM7150) that matter for XNU:
+ *
+ *   - The interrupt controller is a GIC-400, i.e. **GICv2**: there are no
+ *     redistributors and no ICC_* system registers. Interrupts are acked and
+ *     EOI'd through GICC_IAR / GICC_EOIR, and cross-CPU signals go out
+ *     through GICD_SGIR.
+ *   - Cortex-A53 is ARMv8.0: no LSE atomics (__ARM_ENABLE_SWAP__) and none of
+ *     the v8.1 features (PAN). AES/SHA1/SHA2/CRC32 are present.
+ *   - The architected timers use the standard PPI numbers, unlike Qualcomm's
+ *     SM7150 numbering: dts says
+ *         interrupts = <PPI 2 sec-phys, PPI 3 phys, PPI 4 virt, PPI 1 hyp>
+ *     so the virtual timer XNU drives (CNTV) is INTID 16 + 4 = 20.
+ *
+ * Addresses (from the live device tree):
+ *     GICD  0x0b000000  0x1000
+ *     GICC  0x0b002000  0x1000
+ * They are not compiled in: pe_fiq.c reads /arm-io/gic "reg" from the ADT, so
+ * the same code serves QEMU (gic-version=2) and the phone.
+ */
+
+#ifndef _PEXPERT_ARM64_MSM8953_H
+#define _PEXPERT_ARM64_MSM8953_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+/*
+ * Reuse the SWEET bring-up paths wholesale (PRNG, VM bootstrap, trustcache,
+ * the PSCI secondary entry and the early console). Only the interrupt
+ * controller and the timer PPI differ, and those are selected by HAS_GIC_V2
+ * below. Everything SWEET-specific that assumes GICv3 lives inside
+ * "#if HAS_GIC_V3" blocks and is therefore not compiled here.
+ */
+#define SWEET                     1
+
+#define MSM8953                   1
+
+/*
+ * machine_routines.c clamps cpus=N against SWEET_SMP_MAX_CPUS (the code path
+ * is shared with sweet), so the name stays even on this SoC.
+ */
+#define SWEET_SMP_MAX_CPUS        8
+
+/* Eight identical A53 cores, one homogeneous SMP cluster. */
+#define MSM8953_SMP_MAX_CPUS      8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_16K_PG__            1
+
+/* GICv2, not v3. */
+#define HAS_GIC_V2                1
+#define NO_GIC_V3                 1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * Timer PPIs: dts relative numbers 1/2/3/4 (hyp, sec-phys, phys, virt) map to
+ * INTID 17/18/19/20, so the virtual timer is 20.
+ */
+#define MSM8953_VTIMER_INTID      20
+#define MSM8953_PTIMER_INTID      19
+
+/* SweetCPU.cpp (shared with sweet) raises the cross-CPU SGI by this name. */
+#define SWEET_IPI_SGI             1
+#define MSM8953_IPI_SGI           1
+
+#define GIC_SPURIOUS_IRQ          1023
+
+/* ---- GICv2 (ARM GIC-400) register offsets; Arm IHI 0048B ---- */
+
+/* Distributor */
+#define GICD_CTLR                 0x000
+#define GICD_TYPER                0x004
+#define GICD_IIDR                 0x008
+#define GICD_IGROUPR              0x080
+#define GICD_ISENABLER            0x100
+#define GICD_ICENABLER            0x180
+#define GICD_ISPENDR              0x200
+#define GICD_ICPENDR              0x280
+#define GICD_ISACTIVER            0x300
+#define GICD_ICACTIVER            0x380
+#define GICD_IPRIORITYR           0x400
+#define GICD_ITARGETSR            0x800
+#define GICD_ICFGR                0xC00
+#define GICD_SGIR                 0xF00
+
+/* Distributor control bits */
+#define GICD_CTLR_ENABLE          0x1     /* GICv2: one bit enables the distributor */
+#define GICD_CTLR_RWP             0x80000000
+
+/* Software Generated Interrupt register (GICv2 path for an SGI) */
+#define GICD_SGIR_SGIINTID(x)     ((x) & 0xF)
+#define GICD_SGIR_NSATT           (1U << 15)
+#define GICD_SGIR_TARGET_LIST(x)  (((x) & 0xFF) << 16)
+#define GICD_SGIR_TARGET_FILTER_SELF  (2U << 24)
+
+/* CPU interface */
+#define GICC_CTLR                 0x0000
+#define GICC_PMR                  0x0004
+#define GICC_BPR                  0x0008
+#define GICC_IAR                  0x000C
+#define GICC_EOIR                 0x0010
+#define GICC_RPR                  0x0014
+#define GICC_HPPIR                0x0018
+#define GICC_DIR                  0x1000
+
+/* CPU interface control bits */
+#define GICC_CTLR_ENABLE          0x1
+
+/* GICC_IAR/EOIR special values */
+#define GICC_IAR_SPURIOUS         1023
+
+#endif /* ! _PEXPERT_ARM64_MSM8953_H */
