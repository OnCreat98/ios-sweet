+	extern void gic_v2_send_sgi(unsigned int sgi, unsigned int target_mask);
+	if (aff0 >= 8) {
+		panic("SWEET CPU: GICv2 SGI target out of range (%u)", aff0);
+	}
+	gic_v2_send_sgi(SWEET_IPI_SGI, 1U << aff0);
+#else
 	if (aff0 >= 16) {
 		panic("SWEET CPU: SGI target requires unsupported range selector");
 	}
@@ -224,8 +237,8 @@ SweetCPU::signalCPU(IOCPU *target)
