diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 2545cf9..6f8d03c 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -217,6 +217,19 @@ SweetCPU::signalCPU(IOCPU *target)
 	/* Use the TARGET affinity, including Aff1, never the sender's MPIDR. */
 	uint64_t mpidr = topology->cpus[logical].phys_id;
 	unsigned int aff0 = mpidr & 0xff;
+	__builtin_arm_dsb(DSB_ISHST);
+#if HAS_GIC_V2
+	/*
+	 * GICv2 has no ICC_SGI1R_EL1. An SGI is raised by writing a target-list
+	 * bitmap to GICD_SGIR, so only Aff0 is routable (cores 0..7), which is
+	 * exactly this SoC's layout: eight A53s numbered 0..7.
+	 */
+	extern "C" void gic_v2_send_sgi(unsigned int sgi, unsigned int target_mask);
+	if (aff0 >= 8) {
+		panic("SWEET CPU: GICv2 SGI target out of range (%u)", aff0);
+	}
+	gic_v2_send_sgi(SWEET_IPI_SGI, 1U << aff0);
+#else
 	if (aff0 >= 16) {
 		panic("SWEET CPU: SGI target requires unsupported range selector");
 	}
@@ -224,8 +237,8 @@ SweetCPU::signalCPU(IOCPU *target)
 	    (((mpidr >> 16) & 0xff) << 32) |
 	    (((mpidr >> 8) & 0xff) << 16) |
 	    ((uint64_t)SWEET_IPI_SGI << 24) | (1ULL << aff0);
-	__builtin_arm_dsb(DSB_ISHST);
 	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+#endif
 	__builtin_arm_isb(ISB_SY);
 }
 
